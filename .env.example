# React settings. Copy this file to .env and fill it in, then restart "npm run dev".
# Everything here ends up in the PUBLIC website code that every visitor downloads:
# never put a secret here (no kiosk key, no passwords).

# the backend's address (laptop: http://localhost:8000)
VITE_API_URL=http://localhost:8000

# laptop only: the backend copies started by start-servers.bat (leave it out on the real server)
VITE_API_PORTS=8000,8001,8002,8003

# public uploads (profile photos, blank forms) on Supabase; leave it out to use the backend's /storage
VITE_STORAGE_URL=https://<project-ref>.supabase.co/storage/v1/object/public/mytrack/

# Sign in with Google (a client ID is public, this is fine)
VITE_GOOGLE_CLIENT_ID=
