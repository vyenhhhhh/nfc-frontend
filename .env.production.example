# Copy this file to .env.production and put the real addresses, then run: npm run build
# (npm run dev keeps using .env, so your laptop setup is not affected)

# the Laravel server (no /api at the end)
VITE_API_URL=https://YOUR-SERVER-ADDRESS

# uploaded files: the same value as in your .env (Supabase Storage public bucket)
VITE_STORAGE_URL=
